# Salin file ini menjadi .env lalu sesuaikan bila perlu:
#   cp .env.example .env
# Tanpa file .env, nilai default di bawah ini yang dipakai.

# Port di komputer host
WEB_PORT=8080
PMA_PORT=8081

# Kredensial MySQL (dipakai aplikasi & phpMyAdmin)
DB_USER=mis
DB_PASS=mis123
DB_ROOT_PASS=root123

# Alamat situs profil developer (tombol "About Developer" di halaman guest)
# contoh: https://username.github.io/web-profil/  atau  http://localhost/web-profil/
PROFILE_URL=#
